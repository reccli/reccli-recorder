  "project": {
    "name": "reccli-public",
    "description": "RecCli is a tri-layer memory system for AI coding agents: .devproject provides a durable project feature map, .devsession summaries provide compact working memory, and full .devsession conversations remain the linked source of truth. This public repository contains the deployed Next.js website for that product plus historical code from an earlier terminal-recorder direction.",
    "status": "active",
    "source": "manual"
